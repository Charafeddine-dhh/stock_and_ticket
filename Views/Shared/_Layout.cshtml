@inject StockPortal.Services.ICurrentUserService CurrentUser
@inject StockPortal.Data.StockDbContext DbContext
@inject StockPortal.Services.INotificationService NotificationService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IT Stock & Helpdesk Portal</title>
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 & FontAwesome 6 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    
    <style>
        :root {
            --sidebar-width: 260px;
            --primary-color: #2563eb;
            --sidebar-bg: #0f172a;
            --sidebar-hover: #1e293b;
            --body-bg: #f8fafc;
            --card-border: #e2e8f0;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--body-bg);
            color: #1e293b;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        /* Sidebar Styling */
        .sidebar {
            width: var(--sidebar-width);
            background-color: var(--sidebar-bg);
            min-height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1000;
            transition: all 0.3s;
            display: flex;
            flex-direction: column;
        }

        .sidebar-brand {
            padding: 1.5rem 1.25rem;
            color: #ffffff;
            font-weight: 700;
            font-size: 1.15rem;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            border-bottom: 1px solid #1e293b;
            text-decoration: none;
        }

        .sidebar-brand i {
            color: #38bdf8;
            font-size: 1.4rem;
        }

        .sidebar-nav {
            list-style: none;
            padding: 1rem 0.75rem;
            margin: 0;
            flex-grow: 1;
        }

        .nav-category {
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #64748b;
            padding: 0.75rem 0.75rem 0.25rem 0.75rem;
        }

        .sidebar-nav .nav-link {
            color: #94a3b8;
            padding: 0.7rem 0.85rem;
            border-radius: 0.5rem;
            font-weight: 500;
            font-size: 0.92rem;
            display: flex;
            align-items: center;
            gap: 0.85rem;
            transition: all 0.15s ease-in-out;
            margin-bottom: 0.25rem;
            text-decoration: none;
        }

        .sidebar-nav .nav-link:hover {
            color: #f8fafc;
            background-color: var(--sidebar-hover);
        }

        .sidebar-nav .nav-link.active {
            color: #ffffff;
            background-color: var(--primary-color);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
        }

        .sidebar-nav .nav-link i {
            width: 20px;
            text-align: center;
            font-size: 1.05rem;
        }

        /* Main Content Wrapper */
        .main-wrapper {
            margin-left: var(--sidebar-width);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .top-navbar {
            background-color: #ffffff;
            border-bottom: 1px solid var(--card-border);
            padding: 0.85rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 999;
        }

        .content-area {
            padding: 2rem;
            flex-grow: 1;
        }

        /* Modern Card Styling */
        .card {
            border: 1px solid var(--card-border);
            border-radius: 0.75rem;
            box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.05);
            background-color: #ffffff;
        }

        .card-header {
            background-color: #ffffff;
            border-bottom: 1px solid var(--card-border);
            padding: 1.15rem 1.35rem;
            font-weight: 600;
        }

        .stat-card {
            border-radius: 0.75rem;
            padding: 1.35rem;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.06);
        }

        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 0.65rem;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.35rem;
        }

        /* Table Styling */
        .table > :not(caption) > * > * {
            padding: 0.85rem 1rem;
            vertical-align: middle;
        }

        .table-hover tbody tr:hover {
            background-color: #f1f5f9;
        }

        /* Footer */
        .portal-footer {
            padding: 1.25rem 2rem;
            font-size: 0.85rem;
            color: #64748b;
            border-top: 1px solid var(--card-border);
            background-color: #ffffff;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Sidebar -->
    <aside class="sidebar">
        <a href="@Url.Action("Index", "Home")" class="sidebar-brand">
            <i class="fa-solid fa-server"></i>
            <div>
                <div>Stock & Helpdesk</div>
                <div style="font-size: 0.68rem; color: #94a3b8; font-weight: normal;">IT Asset & Service Portal</div>
            </div>
        </a>

        @{
            int openTicketsCount = 0;
            int overdueMaintCount = 0;
            int unreadNotifsCount = 0;
            try
            {
                var today = DateTime.Now.Date;
                var ticketsQuery = DbContext.Tickets.Where(t => t.StatusId == 1 || t.StatusId == 2);

                if (CurrentUser.IsMaintenance())
                {
                    var myTeam = CurrentUser.GetMaintenanceTeam();
                    if (!string.IsNullOrWhiteSpace(myTeam))
                    {
                        ticketsQuery = ticketsQuery.Where(t => t.TargetTeam == myTeam);
                    }
                }
                else if (CurrentUser.IsEndUser())
                {
                    var userObj = CurrentUser.GetCurrentUser();
                    if (userObj?.DepartmentId != null)
                    {
                        ticketsQuery = ticketsQuery.Where(t => t.OpenedByUser != null && t.OpenedByUser.DepartmentId == userObj.DepartmentId);
                    }
                    else
                    {
                        var uid = CurrentUser.GetUserId();
                        ticketsQuery = ticketsQuery.Where(t => t.OpenedBy == uid || t.OnBehalfOf == uid);
                    }
                }
                else if (CurrentUser.IsAdmin())
                {
                    var myTeam = CurrentUser.GetMaintenanceTeam();
                    if (!string.IsNullOrWhiteSpace(myTeam))
                    {
                        ticketsQuery = ticketsQuery.Where(t => t.TargetTeam == myTeam);
                    }
                }

                openTicketsCount = ticketsQuery.Count();
                overdueMaintCount = DbContext.Assets.Count(a => a.NeedsPeriodic == true && a.NextPeriodic.HasValue && a.NextPeriodic.Value < today);

                int currentUid = CurrentUser.GetUserId();
                if (currentUid > 0)
                {
                    unreadNotifsCount = DbContext.Notifications.Count(n => n.UserId == currentUid && !n.IsRead);
                }
            }
            catch {}
        }
        <ul class="sidebar-nav">
            @if (CurrentUser.IsAdmin())
            {
                <li class="nav-category">Operations</li>
                <li>
                    <a href="@Url.Action("Index", "Home")" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                        <i class="fa-solid fa-chart-pie"></i>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "Notifications")" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Notifications" ? "active" : "")">
                        <i class="fa-solid fa-bell"></i>
                        <span class="flex-grow-1">Notifications</span>
                        @if (unreadNotifsCount > 0)
                        {
                            <span class="badge bg-danger rounded-pill" style="font-size: 0.7rem;">@unreadNotifsCount</span>
                        }
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "Assets")" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Assets" ? "active" : "")">
                        <i class="fa-solid fa-boxes-stacked"></i>
                        <span>Stock & Assets</span>
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "Tickets")" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Tickets" ? "active" : "")">
                        <i class="fa-solid fa-ticket"></i>
                        <span class="flex-grow-1">Tickets & Helpdesk</span>
                        @if (openTicketsCount > 0)
                        {
                            <span class="badge bg-danger rounded-pill" style="font-size: 0.7rem;">@openTicketsCount</span>
                        }
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "Maintenance")" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Maintenance" ? "active" : "")">
                        <i class="fa-solid fa-screwdriver-wrench"></i>
                        <span class="flex-grow-1">Maintenance</span>
                        @if (overdueMaintCount > 0)
                        {
                            <span class="badge bg-warning text-dark rounded-pill" style="font-size: 0.7rem;">@overdueMaintCount</span>
                        }
                    </a>
                </li>

                <li class="nav-category mt-3">Administration</li>
                <li>
                    <a href="@Url.Action("Index", "DeviceForms")" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "DeviceForms" ? "active" : "")">
                        <i class="fa-solid fa-shapes"></i>
                        <span>Device Forms & Templates</span>
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "Directory")" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Directory" ? "active" : "")">
                        <i class="fa-solid fa-sitemap"></i>
                        <span>Master Directory & RBAC</span>
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Profile", "Account")" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Account" ? "active" : "")">
                        <i class="fa-solid fa-user-circle"></i>
                        <span>My Domain Profile</span>
                    </a>
                </li>
            }
            else if (CurrentUser.IsMaintenance())
            {
                <li class="nav-category">Engineering Queue</li>
                <li>
                    <a href="@Url.Action("Index", "Notifications")" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Notifications" ? "active" : "")">
                        <i class="fa-solid fa-bell text-warning"></i>
                        <span class="flex-grow-1">Notifications</span>
                        @if (unreadNotifsCount > 0)
                        {
                            <span class="badge bg-danger rounded-pill" style="font-size: 0.7rem;">@unreadNotifsCount</span>
                        }
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "Tickets")" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Tickets" ? "active" : "")">
                        <i class="fa-solid fa-users-gear text-info"></i>
                        <span class="flex-grow-1">@CurrentUser.GetMaintenanceTeam() Queue</span>
                        @if (openTicketsCount > 0)
                        {
                            <span class="badge bg-danger rounded-pill" style="font-size: 0.7rem;">@openTicketsCount</span>
                        }
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "Assets")" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Assets" ? "active" : "")">
                        <i class="fa-solid fa-boxes-stacked"></i>
                        <span>Hospital Assets</span>
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "Maintenance")" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Maintenance" ? "active" : "")">
                        <i class="fa-solid fa-screwdriver-wrench"></i>
                        <span class="flex-grow-1">Maintenance Logs</span>
                        @if (overdueMaintCount > 0)
                        {
                            <span class="badge bg-warning text-dark rounded-pill" style="font-size: 0.7rem;">@overdueMaintCount</span>
                        }
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "DeviceForms")" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "DeviceForms" ? "active" : "")">
                        <i class="fa-solid fa-shapes text-warning"></i>
                        <span>Device Forms & Specs</span>
                    </a>
                </li>

                <li class="nav-category mt-3">Account</li>
                <li>
                    <a href="@Url.Action("Profile", "Account")" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Account" ? "active" : "")">
                        <i class="fa-solid fa-user-circle"></i>
                        <span>My Domain Profile</span>
                    </a>
                </li>
            }
            else
            {
                <li class="nav-category">My Workspace</li>
                <li>
                    <a href="@Url.Action("Index", "Notifications")" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Notifications" ? "active" : "")">
                        <i class="fa-solid fa-bell text-warning"></i>
                        <span class="flex-grow-1">Notifications</span>
                        @if (unreadNotifsCount > 0)
                        {
                            <span class="badge bg-danger rounded-pill" style="font-size: 0.7rem;">@unreadNotifsCount</span>
                        }
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "Assets")" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Assets" ? "active" : "")">
                        <i class="fa-solid fa-laptop text-primary"></i>
                        <span>My Equipment</span>
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Index", "Tickets")" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Tickets" ? "active" : "")">
                        <i class="fa-solid fa-ticket text-info"></i>
                        <span>My Service Tickets</span>
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("Create", "Tickets")" class="nav-link">
                        <i class="fa-solid fa-plus-circle text-success"></i>
                        <span>Open New Ticket</span>
                    </a>
                </li>

                <li class="nav-category mt-3">Account</li>
                <li>
                    <a href="@Url.Action("Profile", "Account")" class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Account" ? "active" : "")">
                        <i class="fa-solid fa-user-circle"></i>
                        <span>My Domain Profile</span>
                    </a>
                </li>
            }
        </ul>

        <!-- Bottom Domain User Identity Badge -->
        <a href="@Url.Action("Profile", "Account")" class="text-decoration-none" style="padding: 1.15rem; border-top: 1px solid #1e293b; background-color: #0b1120;">
            <div class="d-flex align-items-center gap-2">
                <div style="width: 36px; height: 36px; background: #0284c7; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 700; color: #ffffff; font-size: 0.9rem;">
                    @(CurrentUser.GetFullName().Substring(0, 1))
                </div>
                <div class="overflow-hidden">
                    <div class="text-white text-truncate fw-semibold" style="font-size: 0.85rem;">@CurrentUser.GetFullName()</div>
                    <div class="text-info text-truncate d-flex align-items-center gap-1" style="font-size: 0.72rem;">
                        <i class="fa-solid fa-shield-halved" style="font-size: 0.65rem;"></i>
                        <span>@(CurrentUser.IsMaintenance() ? $"MAINTENANCE ({CurrentUser.GetMaintenanceTeam() ?? "GENERAL"})" : CurrentUser.GetRole())</span>
                    </div>
                </div>
            </div>
        </a>
    </aside>

    <!-- Main Content Wrapper -->
    <div class="main-wrapper">
        <!-- Top Navbar -->
        <header class="top-navbar">
            <div class="d-flex align-items-center gap-3">
                <h5 class="mb-0 fw-bold">@ViewData["Title"]</h5>
            </div>
            <div class="d-flex align-items-center gap-3">
                <!-- Notifications Bell Icon -->
                <a href="@Url.Action("Index", "Notifications")" id="navNotificationsLink" class="btn btn-sm btn-light border position-relative" title="Notifications">
                    <i class="fa-solid fa-bell text-secondary"></i>
                    @if (unreadNotifsCount > 0)
                    {
                        <span id="navUnreadBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65rem;">
                            @unreadNotifsCount
                        </span>
                    }
                </a>

                <!-- Domain User Pill -->
                <div class="dropdown">
                    <button class="btn btn-sm btn-light border dropdown-toggle d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                        <span class="badge bg-success rounded-circle p-1" style="width: 8px; height: 8px;"></span>
                        <span class="fw-semibold">@CurrentUser.GetFullName()</span>
                        <span class="text-muted small">(@CurrentUser.GetDomainUser())</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0">
                        <li><h6 class="dropdown-header">Windows Domain SSO</h6></li>
                        <li>
                            <div class="px-3 py-1 text-muted small">
                                <div>Domain: <strong>@Environment.UserDomainName</strong></div>
                                <div>User: <strong>@CurrentUser.GetDomainUser()</strong></div>
                                <div>Role: <strong>@(CurrentUser.IsMaintenance() ? $"MAINTENANCE ({CurrentUser.GetMaintenanceTeam() ?? "GENERAL"})" : CurrentUser.GetRole())</strong></div>
                                @if (CurrentUser.IsMaintenance())
                                {
                                    <div>Team: <strong>@(CurrentUser.GetMaintenanceTeam() ?? "GENERAL")</strong></div>
                                }
                            </div>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="@Url.Action("Profile", "Account")"><i class="fa-solid fa-user me-2 text-primary"></i> My Profile & Equipment</a></li>
                        <li><a class="dropdown-item" href="@Url.Action("Profile", "Account")"><i class="fa-solid fa-users me-2 text-warning"></i> Switch User (Testing)</a></li>
                    </ul>
                </div>

                <a href="@Url.Action("Create", "Tickets")" class="btn btn-outline-primary btn-sm">
                    <i class="fa-solid fa-plus me-1"></i> New Ticket
                </a>
                @if (CurrentUser.CanManageAssets())
                {
                    <a href="@Url.Action("Create", "Assets")" class="btn btn-primary btn-sm">
                        <i class="fa-solid fa-plus me-1"></i> Add Asset
                    </a>
                }
            </div>
        </header>

        <!-- Flash Messages -->
        <div class="container-fluid px-4 pt-3">
            <!-- Desktop Notification Permission Banner -->
            <div id="desktopNotifBanner" class="alert alert-primary alert-dismissible fade show align-items-center justify-content-between p-3 mb-3 shadow-sm border-0" role="alert" style="display: none !important;">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-primary text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                        <i class="fa-solid fa-bell fs-6"></i>
                    </div>
                    <div>
                        <strong class="d-block text-dark" style="font-size: 0.9rem;">Enable Desktop Notifications</strong>
                        <span class="text-secondary small">Receive instant popup alerts on your screen when tickets are opened, updated, or replied to.</span>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button id="btnEnableDesktopNotifs" type="button" class="btn btn-sm btn-primary px-3 fw-semibold">
                        <i class="fa-solid fa-bell me-1"></i> Enable Popups
                    </button>
                    <button type="button" class="btn-close ms-2" data-bs-dismiss="alert" aria-label="Close" id="btnDismissNotifBanner"></button>
                </div>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                    <i class="fa-solid fa-circle-check fs-5"></i>
                    <div>@TempData["SuccessMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                    <i class="fa-solid fa-circle-exclamation fs-5"></i>
                    <div>@TempData["ErrorMessage"]</div>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
        </div>

        <!-- Body Area -->
        <main class="content-area pt-2">
            @RenderBody()
        </main>

        <!-- Footer -->
        <footer class="portal-footer d-flex justify-content-between align-items-center">
            <div>
                &copy; 2026 <strong>Stock & Helpdesk Management System</strong> &bull; MariaDB Database: <code>stock</code>
            </div>
            <div class="text-muted small">
                Windows Domain Authentication Active &bull; Host: <code>@Environment.MachineName</code>
            </div>
        </footer>
    </div>

    <!-- Toast Notification Container for Floating Alerts -->
    <div aria-live="polite" aria-atomic="true" class="position-fixed top-0 end-0 p-3" style="z-index: 99999; pointer-events: none;">
        <div id="toastNotificationContainer" class="toast-container" style="pointer-events: auto;"></div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            const displayedNotifKey = "displayed_popup_notif_ids";
            let displayedIds = new Set();
            try {
                const stored = sessionStorage.getItem(displayedNotifKey);
                if (stored) {
                    JSON.parse(stored).forEach(id => displayedIds.add(id));
                }
            } catch (e) { }

            // Web Audio API notification chime with suspended state recovery
            function playNotificationChime() {
                try {
                    const AudioContextClass = window.AudioContext || window.webkitAudioContext;
                    if (!AudioContextClass) return;
                    const ctx = new AudioContextClass();
                    if (ctx.state === "suspended") {
                        ctx.resume().catch(() => {});
                    }
                    const osc = ctx.createOscillator();
                    const gain = ctx.createGain();
                    osc.type = "sine";
                    osc.frequency.setValueAtTime(587.33, ctx.currentTime);
                    osc.frequency.setValueAtTime(880, ctx.currentTime + 0.1);
                    gain.gain.setValueAtTime(0.18, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.35);
                    osc.connect(gain);
                    gain.connect(ctx.destination);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.35);
                } catch (e) { }
            }

            // Desktop notification permission prompt banner
            function initDesktopNotificationBanner() {
                if (!("Notification" in window)) return;

                const banner = document.getElementById("desktopNotifBanner");
                const btnEnable = document.getElementById("btnEnableDesktopNotifs");
                const dismissed = sessionStorage.getItem("desktop_notif_banner_dismissed");

                if (Notification.permission === "default" && !dismissed && banner) {
                    banner.style.setProperty("display", "flex", "important");
                }

                if (btnEnable) {
                    btnEnable.addEventListener("click", async function () {
                        try {
                            const permission = await Notification.requestPermission();
                            if (banner) {
                                banner.style.setProperty("display", "none", "important");
                            }
                            if (permission === "granted") {
                                playNotificationChime();
                                showDesktopNotification({
                                    id: 0,
                                    title: "Notifications Enabled!",
                                    message: "You will now receive desktop popup alerts when tickets are created, updated, or replied to.",
                                    linkUrl: "/Notifications"
                                });
                            }
                        } catch (err) {
                            console.error("Error requesting notification permission:", err);
                        }
                    });
                }

                const btnDismiss = document.getElementById("btnDismissNotifBanner");
                if (btnDismiss) {
                    btnDismiss.addEventListener("click", function () {
                        sessionStorage.setItem("desktop_notif_banner_dismissed", "true");
                    });
                }
            }

            // Native Browser Desktop Popup (OS level)
            function showDesktopNotification(item) {
                if (!("Notification" in window) || Notification.permission !== "granted") {
                    return;
                }
                try {
                    const title = item.title || "Ticket Notification";
                    const options = {
                        body: item.message || "",
                        icon: "/favicon.ico",
                        badge: "/favicon.ico",
                        tag: "notif_" + item.id,
                        renotify: true
                    };
                    const notification = new Notification(title, options);
                    notification.onclick = function (e) {
                        e.preventDefault();
                        window.focus();
                        if (item.linkUrl) {
                            window.location.href = item.linkUrl;
                        }
                        notification.close();
                    };
                } catch (e) {
                    console.error("Desktop notification popup error:", e);
                }
            }

            // In-page Floating Toast Notification
            function showNotificationToast(item) {
                const container = document.getElementById("toastNotificationContainer");
                if (!container) return;

                const toastId = "notif_toast_" + item.id;
                if (document.getElementById(toastId)) return;

                const iconClass = item.type === "TicketMessage" 
                    ? "fa-solid fa-comments text-info" 
                    : item.type === "TicketStatus" 
                    ? "fa-solid fa-circle-check text-warning" 
                    : "fa-solid fa-ticket text-primary";

                const toastEl = document.createElement("div");
                toastEl.id = toastId;
                toastEl.className = "toast show shadow-lg border border-primary-subtle mb-2";
                toastEl.setAttribute("role", "alert");
                toastEl.setAttribute("aria-live", "assertive");
                toastEl.setAttribute("aria-atomic", "true");
                toastEl.style.backgroundColor = "#ffffff";
                toastEl.style.minWidth = "320px";
                toastEl.style.boxShadow = "0 0.5rem 1.2rem rgba(0,0,0,0.2)";

                toastEl.innerHTML = `
                    <div class="toast-header bg-white border-bottom-0 pb-1">
                        <i class="${iconClass} me-2 fs-6"></i>
                        <strong class="me-auto text-dark" style="font-size: 0.85rem;">${item.title || "Notification"}</strong>
                        <small class="text-muted" style="font-size: 0.72rem;">${item.timeAgo || "Just now"}</small>
                        <button type="button" class="btn-close ms-2" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                    <div class="toast-body pt-1 pb-2">
                        <div class="text-secondary small mb-2" style="font-size: 0.82rem; white-space: pre-wrap;">${item.message}</div>
                        <div class="d-flex justify-content-end gap-2">
                            <a href="${item.linkUrl || '/Notifications'}" class="btn btn-primary btn-sm py-0 px-2" style="font-size: 0.75rem;">
                                <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> Open Ticket
                            </a>
                        </div>
                    </div>
                `;

                container.appendChild(toastEl);
                try {
                    const bsToast = new bootstrap.Toast(toastEl, { delay: 9000, autohide: true });
                    bsToast.show();
                } catch (e) {
                    toastEl.style.display = "block";
                    toastEl.style.opacity = "1";
                }
            }

            async function checkUnreadNotifications() {
                try {
                    const res = await fetch("/Notifications/GetLatestUnread", {
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    });
                    if (!res.ok) return;
                    const data = await res.json();

                    // Update navbar badge dynamically
                    const badge = document.getElementById("navUnreadBadge");
                    const navLink = document.getElementById("navNotificationsLink");
                    if (data.count > 0) {
                        if (badge) {
                            badge.textContent = data.count;
                            badge.style.display = "inline-block";
                        } else if (navLink) {
                            const newBadge = document.createElement("span");
                            newBadge.id = "navUnreadBadge";
                            newBadge.className = "position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger";
                            newBadge.style.fontSize = "0.65rem";
                            newBadge.textContent = data.count;
                            navLink.appendChild(newBadge);
                        }
                    } else if (badge) {
                        badge.style.display = "none";
                    }

                    if (Array.isArray(data.notifications)) {
                        let hasNew = false;
                        data.notifications.forEach(item => {
                            if (!displayedIds.has(item.id)) {
                                displayedIds.add(item.id);
                                hasNew = true;

                                // 1. Show in-page toast popup
                                showNotificationToast(item);

                                // 2. Show native browser desktop popup
                                showDesktopNotification(item);
                            }
                        });
                        if (hasNew) {
                            playNotificationChime();
                            try {
                                sessionStorage.setItem(displayedNotifKey, JSON.stringify(Array.from(displayedIds)));
                            } catch (e) { }
                        }
                    }
                } catch (e) { }
            }

            document.addEventListener("DOMContentLoaded", function () {
                initDesktopNotificationBanner();
                checkUnreadNotifications();
                setInterval(checkUnreadNotifications, 8000);
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
