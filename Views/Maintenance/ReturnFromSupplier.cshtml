@model StockPortal.Models.AssetMaintenance
@{
    ViewData["Title"] = "Return Asset from Maintenance";
    var asset = Model.Asset;
    var supplier = Model.Supplier;
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <!-- Work Order Information Header -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-success bg-opacity-10 py-3 border-bottom border-success">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h5 class="mb-0 fw-bold text-dark">
                            <i class="fa-solid fa-box-open text-success me-2"></i> Receive Asset & Complete Work Order #@Model.Id
                        </h5>
                        <small class="text-muted">Return equipment from supplier, log replaced parts in JSON format, and reassign custody</small>
                    </div>
                    <span class="badge bg-success text-white px-3 py-2">
                        <i class="fa-solid fa-check-double me-1"></i> Phase 2: Return & Receiving
                    </span>
                </div>
            </div>

            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="text-muted small text-uppercase fw-semibold">Equipment Tag</div>
                        <div class="fw-bold text-primary fs-5">@(asset?.HospitalNo ?? ("#" + Model.AssetId))</div>
                        <div class="small text-muted">@asset?.Brand @asset?.Type</div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-muted small text-uppercase fw-semibold">Maintenance Vendor</div>
                        <div class="fw-bold text-dark fs-5">@(supplier?.Name ?? "External Supplier")</div>
                        <span class="badge bg-warning text-dark mt-1">Currently in Vendor Custody</span>
                    </div>
                    <div class="col-md-3">
                        <div class="text-muted small text-uppercase fw-semibold">Sent Date</div>
                        <div class="fw-bold text-dark">@(Model.SentDate?.ToString("yyyy-MM-dd HH:mm") ?? Model.TimStamp?.ToString("yyyy-MM-dd HH:mm"))</div>
                        <div class="small text-muted">@Model.DaysInMaintenance day(s) in maintenance</div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-muted small text-uppercase fw-semibold">Linked Ticket</div>
                        @if (Model.TicketId.HasValue)
                        {
                            <a href="@Url.Action("Details", "Tickets", new { id = Model.TicketId.Value })" class="fw-bold text-decoration-none">
                                <i class="fa-solid fa-ticket me-1"></i> Ticket #@Model.TicketId.Value
                            </a>
                            <div><span class="badge bg-warning text-dark border">Under Maintenance</span></div>
                        }
                        else
                        {
                            <span class="text-muted">Direct / Standalone</span>
                        }
                    </div>

                    <div class="col-12 mt-3">
                        <div class="p-3 bg-light rounded border">
                            <div class="fw-bold text-secondary small text-uppercase mb-1">
                                <i class="fa-solid fa-file-lines me-1"></i> Initial Reported Issue (Before Sending):
                            </div>
                            <div class="text-dark">@Model.Description</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Work Order Receiving & Custody Reassignment Form -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <form asp-action="ReturnFromSupplier" method="post" id="returnForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="partsJson" id="hiddenPartsJson" value="[]" />

                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <!-- 1. Work Resolution & Repair Details -->
                    <h6 class="fw-bold text-uppercase text-secondary pb-2 mb-3 border-bottom">
                        <i class="fa-solid fa-clipboard-check text-success me-2"></i> 1. Vendor Resolution & Action Taken
                    </h6>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Actual Return Date <span class="text-danger">*</span></label>
                            <input type="datetime-local" name="returnDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Maintenance / Invoice Cost ($)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" step="0.01" name="cost" class="form-control" placeholder="0.00" />
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Supplier Repair Summary & Actions Performed <span class="text-danger">*</span></label>
                            <textarea name="actionTaken" class="form-control" rows="3" placeholder="Describe the repairs performed, calibration tests passed, firmware flashed, or vendor warranty resolution..." required></textarea>
                        </div>
                    </div>

                    <!-- 2. Replaced Parts Dynamic Form (Dynamic JSON Builder) -->
                    <div class="d-flex justify-content-between align-items-center pb-2 mb-3 border-bottom">
                        <h6 class="fw-bold text-uppercase text-secondary mb-0">
                            <i class="fa-solid fa-microchip text-primary me-2"></i> 2. Replaced Parts & Components (JSON Specification)
                        </h6>
                        <button type="button" class="btn btn-sm btn-outline-primary fw-bold" id="btnAddPartRow">
                            <i class="fa-solid fa-plus me-1"></i> Add Replaced Part
                        </button>
                    </div>

                    <p class="text-muted small mb-3">
                        Add any hardware parts, components, or modules replaced by the vendor. This information will be compiled dynamically into clean JSON stored in the database.
                    </p>

                    <div class="table-responsive mb-4">
                        <table class="table table-bordered align-middle" id="partsTable">
                            <thead class="table-light small text-uppercase">
                                <tr>
                                    <th style="width: 28%;">Part / Component Name <span class="text-danger">*</span></th>
                                    <th style="width: 20%;">Part / Model Number</th>
                                    <th style="width: 10%;">Qty</th>
                                    <th style="width: 14%;">Cost ($)</th>
                                    <th style="width: 12%;">Warranty?</th>
                                    <th style="width: 16%;">Serial / Notes</th>
                                    <th style="width: 5%;" class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody id="partsTableBody">
                                <!-- Dynamic rows added by JS -->
                            </tbody>
                        </table>
                        <div id="noPartsAlert" class="text-center py-3 bg-light rounded text-muted">
                            <i class="fa-solid fa-circle-info me-1"></i> No parts replaced yet. Click <strong>"Add Replaced Part"</strong> above if components were swapped, or leave empty if only service/inspection was performed.
                        </div>
                    </div>

                    <!-- 3. Custody Reassignment -->
                    <h6 class="fw-bold text-uppercase text-secondary pb-2 mb-3 border-bottom">
                        <i class="fa-solid fa-arrow-right-arrow-left text-warning me-2"></i> 3. Custody Reassignment & Placement
                    </h6>

                    <p class="text-muted small mb-3">
                        Custody must be transferred away from the supplier. Choose whether this asset returns to central department stock (spare pool) or is assigned directly to a hospital staff member.
                    </p>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <div class="card p-3 border h-100 shadow-sm" id="cardDestStock" style="cursor: pointer;" onclick="document.getElementById('destStock').click()">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="returnDestination" id="destStock" value="stock" checked onchange="handleCustodyChange()">
                                    <label class="form-check-label fw-bold text-dark ms-2" for="destStock">
                                        <i class="fa-solid fa-warehouse text-primary me-1"></i> Return to Central Department Stock
                                    </label>
                                </div>
                                <div class="small text-muted ms-4 mt-2">
                                    Asset will become unassigned (Custody: Central Stock / Shared), marked <strong>In Stock</strong> as spare equipment.
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card p-3 border h-100 shadow-sm" id="cardDestUser" style="cursor: pointer;" onclick="document.getElementById('destUser').click()">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="returnDestination" id="destUser" value="user" onchange="handleCustodyChange()">
                                    <label class="form-check-label fw-bold text-dark ms-2" for="destUser">
                                        <i class="fa-solid fa-user-check text-success me-1"></i> Assign Directly to User Custody
                                    </label>
                                </div>
                                <div class="small text-muted ms-4 mt-2">
                                    Assign custody immediately to a specific hospital staff member, marked <strong>In Service</strong>.
                                    @if (Model.PreviousUser != null)
                                    {
                                        <span class="badge bg-light text-primary border mt-1">Previous: @Model.PreviousUser.FullName</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Direct User Picker (Visible when user radio selected) -->
                    <div class="row g-3 mb-3" id="userAssignmentRow" style="display: none;">
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Select Staff Member Custodian <span class="text-danger">*</span></label>
                            <select name="newUserId" id="newUserIdSelect" class="form-select form-select-lg" asp-items="ViewBag.Users">
                                <option value="">-- Choose Hospital Staff Member --</option>
                            </select>
                            <div class="form-text small">Staff member who will assume physical custody of this equipment.</div>
                        </div>
                    </div>

                    <!-- Location / Room Selection -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Physical Room / Floor Location <span class="text-danger">*</span></label>
                            <select name="newRoomId" class="form-select" asp-items="ViewBag.Rooms" required>
                                <option value="">-- Select Physical Room Location --</option>
                            </select>
                            <div class="form-text small">Room or storage unit where equipment is physically delivered.</div>
                        </div>
                    </div>

                    <!-- Form Buttons -->
                    <div class="d-flex justify-content-end gap-2 border-top pt-4">
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-success fw-bold px-4">
                            <i class="fa-solid fa-check-circle me-1"></i> Complete Work Order & Reassign Custody
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // 1. Dynamic Replaced Parts Form Logic
    const partsTableBody = document.getElementById("partsTableBody");
    const noPartsAlert = document.getElementById("noPartsAlert");
    const btnAddPartRow = document.getElementById("btnAddPartRow");
    const hiddenPartsJson = document.getElementById("hiddenPartsJson");
    const returnForm = document.getElementById("returnForm");

    function updateNoPartsAlert() {
        if (partsTableBody.children.length === 0) {
            noPartsAlert.style.display = "block";
        } else {
            noPartsAlert.style.display = "none";
        }
    }

    function addPartRow(item = {}) {
        const tr = document.createElement("tr");
        tr.innerHTML = `
            <td>
                <input type="text" class="form-control form-control-sm part-name" placeholder="e.g. Logic Board, Battery, Fan" value="${item.partName || ''}" required />
            </td>
            <td>
                <input type="text" class="form-control form-control-sm part-number font-monospace" placeholder="e.g. DP/N 0XXV21" value="${item.partNumber || ''}" />
            </td>
            <td>
                <input type="number" class="form-control form-control-sm part-qty text-center" min="1" value="${item.quantity || 1}" required />
            </td>
            <td>
                <input type="number" step="0.01" class="form-control form-control-sm part-cost" placeholder="0.00" value="${item.cost != null ? item.cost : ''}" />
            </td>
            <td class="text-center">
                <input type="checkbox" class="form-check-input part-warranty" ${item.underWarranty ? 'checked' : ''} />
            </td>
            <td>
                <input type="text" class="form-control form-control-sm part-notes" placeholder="Serial / Notes" value="${item.notes || ''}" />
            </td>
            <td class="text-center">
                <button type="button" class="btn btn-sm btn-outline-danger" onclick="removePartRow(this)">
                    <i class="fa-solid fa-trash"></i>
                </button>
            </td>
        `;
        partsTableBody.appendChild(tr);
        updateNoPartsAlert();
    }

    window.removePartRow = function(btn) {
        btn.closest("tr").remove();
        updateNoPartsAlert();
    };

    btnAddPartRow.addEventListener("click", function() {
        addPartRow();
    });

    // 2. Serialize Dynamic Form to JSON on Submission
    returnForm.addEventListener("submit", function(e) {
        const rows = partsTableBody.querySelectorAll("tr");
        const parts = [];

        rows.forEach(tr => {
            const name = tr.querySelector(".part-name").value.trim();
            if (name) {
                parts.push({
                    partName: name,
                    partNumber: tr.querySelector(".part-number").value.trim(),
                    quantity: parseInt(tr.querySelector(".part-qty").value) || 1,
                    cost: parseFloat(tr.querySelector(".part-cost").value) || 0,
                    underWarranty: tr.querySelector(".part-warranty").checked,
                    notes: tr.querySelector(".part-notes").value.trim()
                });
            }
        });

        hiddenPartsJson.value = JSON.stringify(parts);

        // Validation for user selection if user custody chosen
        if (document.getElementById("destUser").checked) {
            const userSelect = document.getElementById("newUserIdSelect");
            if (!userSelect.value) {
                e.preventDefault();
                alert("Please select a staff member to receive asset custody.");
                userSelect.focus();
                return false;
            }
        }
    });

    // 3. Custody Radio Switcher
    function handleCustodyChange() {
        const isUser = document.getElementById("destUser").checked;
        const userRow = document.getElementById("userAssignmentRow");
        const userSelect = document.getElementById("newUserIdSelect");
        const cardStock = document.getElementById("cardDestStock");
        const cardUser = document.getElementById("cardDestUser");

        if (isUser) {
            userRow.style.display = "flex";
            userSelect.required = true;
            cardUser.classList.add("border-success", "bg-success", "bg-opacity-10");
            cardStock.classList.remove("border-primary", "bg-primary", "bg-opacity-10");
        } else {
            userRow.style.display = "none";
            userSelect.required = false;
            cardStock.classList.add("border-primary", "bg-primary", "bg-opacity-10");
            cardUser.classList.remove("border-success", "bg-success", "bg-opacity-10");
        }
    }

    handleCustodyChange();
</script>
}
