@model StockPortal.Models.Ticket
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Work Order #@Model.Id - @Model.Type Service</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        @@media print {
            .no-print { display: none !important; }
            body { background: white !important; padding: 0 !important; font-size: 13px !important; }
            .sheet { border: 1px solid #ccc !important; box-shadow: none !important; margin: 0 !important; }
        }
        body {
            background-color: #f1f5f9;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            padding: 2rem 0;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .sheet {
            width: 800px;
            background: #ffffff;
            border: 1px solid #cbd5e1;
            padding: 40px;
            border-radius: 6px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        }
    </style>
</head>
<body>
    <div class="no-print mb-4 d-flex gap-2">
        <button onclick="window.print()" class="btn btn-primary btn-lg shadow-sm">
            <i class="fa-solid fa-print me-2"></i> Print Field Work Order
        </button>
        <button onclick="window.close()" class="btn btn-outline-secondary btn-lg">
            Close
        </button>
    </div>

    <div class="sheet">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-start border-bottom pb-3 mb-4">
            <div>
                <h4 class="fw-bold mb-1 text-primary">IT SERVICES & BIOMEDICAL HELPDESK</h4>
                <div class="text-muted small">Hospital Technical Support & Equipment Maintenance Department</div>
            </div>
            <div class="text-end">
                <h3 class="fw-bold mb-0">WORK ORDER</h3>
                <div class="fs-5 fw-bold text-dark font-monospace">#@Model.Id</div>
                <div class="badge bg-secondary">@(Model.Status?.Status?.ToUpper() ?? "OPENED")</div>
            </div>
        </div>

        <!-- Ticket Info Matrix -->
        <div class="row g-3 mb-4">
            <div class="col-6">
                <div class="p-3 bg-light rounded">
                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-2">Service Ticket Details</h6>
                    <div><strong>Category:</strong> @Model.Type</div>
                    <div><strong>Priority Level:</strong> @Model.PriorityName</div>
                    <div><strong>Date Opened:</strong> @Model.OpenedDT?.ToString("MMM dd, yyyy HH:mm")</div>
                    <div><strong>Date Closed:</strong> @(Model.ClosedDT?.ToString("MMM dd, yyyy HH:mm") ?? "Pending Completion")</div>
                </div>
            </div>
            <div class="col-6">
                <div class="p-3 bg-light rounded">
                    <h6 class="fw-bold text-dark border-bottom pb-2 mb-2">Personnel</h6>
                    <div><strong>Requester:</strong> @(Model.OpenedByUser?.FullName ?? "Unknown")</div>
                    <div><strong>Department:</strong> @(Model.OpenedByUser?.Department?.Name ?? "General")</div>
                    <div><strong>Assigned Tech:</strong> @(Model.Handler?.TechUser?.FullName ?? "Unassigned")</div>
                    <div><strong>Assigned On:</strong> @(Model.Handler?.AssignedDT?.ToString("MMM dd, yyyy") ?? "N/A")</div>
                </div>
            </div>
        </div>

        <!-- Linked Asset -->
        @if (Model.Asset != null)
        {
            <div class="mb-4">
                <h6 class="fw-bold text-dark border-bottom pb-2 mb-2">Hardware Asset Information</h6>
                <table class="table table-bordered table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Hospital Tag</th>
                            <th>Serial Number</th>
                            <th>Make & Model</th>
                            <th>Equipment Type</th>
                            <th>Physical Location</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="fw-bold font-monospace">@Model.Asset.HospitalNo</td>
                            <td class="font-monospace">@(Model.Asset.SerialNo ?? "N/A")</td>
                            <td>@Model.Asset.Brand</td>
                            <td>@Model.Asset.Type</td>
                            <td>@(Model.Asset.Room?.DisplayName ?? "Unassigned")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }

        <!-- Timeline & Messages -->
        <div class="mb-4">
            <h6 class="fw-bold text-dark border-bottom pb-2 mb-2">Diagnostic Log & Reported Issues</h6>
            @if (!Model.Messages.Any())
            {
                <div class="text-muted fst-italic">No message entries logged.</div>
            }
            else
            {
                <div class="border rounded p-3">
                    @foreach (var m in Model.Messages.OrderBy(x => x.TimeStamp))
                    {
                        <div class="mb-2 pb-2 @(m != Model.Messages.Last() ? "border-bottom" : "")">
                            <div class="d-flex justify-content-between small text-muted">
                                <strong>@(m.User?.FullName ?? "Staff"):</strong>
                                <span>@m.TimeStamp?.ToString("MMM dd, yyyy HH:mm")</span>
                            </div>
                            <div class="mt-1" style="white-space: pre-wrap;">@m.Msg</div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Field Sign-Off Section -->
        <div class="border-top pt-4 mt-5">
            <div class="row text-center">
                <div class="col-4">
                    <div style="border-bottom: 1px solid #000; height: 50px;"></div>
                    <div class="small fw-semibold mt-1">Technician Signature & Date</div>
                </div>
                <div class="col-4">
                    <div style="border-bottom: 1px solid #000; height: 50px;"></div>
                    <div class="small fw-semibold mt-1">Requester Acceptance & Date</div>
                </div>
                <div class="col-4">
                    <div style="border-bottom: 1px solid #000; height: 50px;"></div>
                    <div class="small fw-semibold mt-1">IT Supervisor Sign-Off</div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
