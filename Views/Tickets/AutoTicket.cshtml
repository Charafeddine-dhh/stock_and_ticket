@model StockPortal.ViewModels.AutoTicketViewModel
@inject StockPortal.Services.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Generate Automated PC Ticket";
    var asset = Model.MatchedAsset;
}

<div class="mb-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1">
            <li class="breadcrumb-item"><a href="@Url.Action("Index", "Tickets")">Tickets</a></li>
            <li class="breadcrumb-item active" aria-current="page">Automated PC Ticket</li>
        </ol>
    </nav>
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="fa-solid fa-bolt text-warning me-2"></i> Automated PC Ticket Generator
            </h3>
            <p class="text-muted mb-0">
                Automatically identifies your workstation hardware, location, and custodian details from the database.
            </p>
        </div>
        <div>
            <a href="@Url.Action("Index")" class="btn btn-outline-secondary btn-sm">
                <i class="fa-solid fa-arrow-left me-1"></i> Back to Tickets
            </a>
        </div>
    </div>
</div>

<form asp-action="AutoTicket" method="post" id="autoTicketForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="DetectedPcName" id="detectedPcNameInput" />
    <input type="hidden" asp-for="ClientIp" />

    <div class="row g-4">
        <!-- Left Column: Workstation & Asset Identification -->
        <div class="col-lg-6">
            <!-- Detection Banner -->
            <div class="card shadow-sm border-0 mb-4 @(Model.IsAssetFound ? "border-start border-4 border-success" : "border-start border-4 border-warning")">
                <div class="card-body p-4">
                    <div class="d-flex align-items-start gap-3">
                        <div class="stat-icon @(Model.IsAssetFound ? "bg-success bg-opacity-10 text-success" : "bg-warning bg-opacity-10 text-warning")" style="width: 52px; height: 52px; font-size: 1.5rem;">
                            <i class="fa-solid @(Model.IsAssetFound ? "fa-laptop-code" : "fa-circle-question")"></i>
                        </div>
                        <div class="flex-grow-1">
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge @(Model.IsAssetFound ? "bg-success" : "bg-warning text-dark") mb-1">
                                    @(Model.IsAssetFound ? "Workstation Recognized in DB" : "Unmapped Workstation")
                                </span>
                                <span class="text-muted small font-monospace">IP: @Model.ClientIp</span>
                            </div>
                            <h5 class="fw-bold mb-1 text-dark">
                                PC Name: <span class="text-primary font-monospace">@Model.DetectedPcName</span>
                            </h5>
                            <p class="small text-muted mb-0">
                                @if (Model.IsAssetFound)
                                {
                                    <span>Matched with Asset Tag: <strong class="text-dark">@(asset?.HospitalNo)</strong> in the Hospital database.</span>
                                }
                                else
                                {
                                    <span>No direct asset record found for host <code>@Model.DetectedPcName</code>. You can link an existing asset below.</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Asset & Location Specs Card -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 fw-bold">
                        <i class="fa-solid fa-server text-primary me-2"></i> Workstation & Location Telemetry
                    </h6>
                    @if (asset != null)
                    {
                        <span class="badge bg-light text-dark border">Asset #@asset.Id</span>
                    }
                </div>
                <div class="card-body p-4">
                    <!-- Linked Asset Selector -->
                    <div class="mb-3">
                        <label asp-for="SelectedAssetId" class="form-label fw-semibold small text-uppercase text-muted">
                            Linked Equipment / Asset Tag
                        </label>
                        <select asp-for="SelectedAssetId" id="assetSelect" class="form-select">
                            <option value="">-- No specific hardware tag --</option>
                            @foreach (var a in Model.AvailableAssets)
                            {
                                <option value="@a.Id" 
                                        data-pc="@a.HospitalNo"
                                        data-brand="@a.Brand" 
                                        data-serial="@a.SerialNo" 
                                        data-room="@a.RoomId"
                                        data-user="@a.UserId"
                                        selected="@(a.Id == Model.SelectedAssetId)">
                                    @(a.HospitalNo) - @(a.Brand) @(a.Type ?? "PC") [S/N: @(a.SerialNo ?? "N/A")]
                                </option>
                            }
                        </select>
                        <div class="form-text small">Hospital name in assets corresponds to the PC name (@Model.DetectedPcName).</div>
                    </div>

                    <!-- Hardware Details Readout -->
                    <div class="bg-light p-3 rounded mb-3 border">
                        <div class="row g-2 small">
                            <div class="col-6">
                                <span class="text-muted d-block">Brand / Make:</span>
                                <strong id="valBrand" class="text-dark">@(asset?.Brand ?? "N/A")</strong>
                            </div>
                            <div class="col-6">
                                <span class="text-muted d-block">Model / No:</span>
                                <strong id="valModel" class="text-dark">@(asset?.ModelNo?.ToString() ?? "N/A")</strong>
                            </div>
                            <div class="col-12 mt-2">
                                <span class="text-muted d-block">Serial Number:</span>
                                <strong id="valSerial" class="text-dark font-monospace">@(asset?.SerialNo ?? "N/A")</strong>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(asset?.Specs))
                            {
                                <div class="col-12 mt-2">
                                    <span class="text-muted d-block">Specs:</span>
                                    <span class="font-monospace text-secondary" style="font-size: 0.78rem;">@asset.Specs</span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Room / Location Information -->
                    <div class="mb-3">
                        <label asp-for="SelectedRoomId" class="form-label fw-semibold small text-uppercase text-muted">
                            <i class="fa-solid fa-location-dot text-danger me-1"></i> Room & Location
                        </label>
                        <select asp-for="SelectedRoomId" id="roomSelect" class="form-select">
                            <option value="">-- Unspecified Room / Location --</option>
                            @foreach (var r in Model.AvailableRooms)
                            {
                                <option value="@r.Id" selected="@(r.Id == Model.SelectedRoomId)">
                                    Room @(r.RoomNo) &bull; Floor @(r.Floor)
                                </option>
                            }
                        </select>
                        <div class="form-text small">This room will be recorded on the ticket and updated on the asset.</div>
                    </div>

                    <!-- Assigned Custodian / User -->
                    <div class="mb-2">
                        <label asp-for="SelectedUserId" class="form-label fw-semibold small text-uppercase text-muted">
                            <i class="fa-solid fa-user-tag text-info me-1"></i> Primary Custodian / Assignee
                        </label>
                        <select asp-for="SelectedUserId" id="userSelect" class="form-select">
                            <option value="">-- Unassigned Custodian --</option>
                            @foreach (var u in Model.AvailableUsers)
                            {
                                <option value="@u.Id" selected="@(u.Id == Model.SelectedUserId)">
                                    @(u.FullName) (@(u.Role ?? "Staff"))
                                </option>
                            }
                        </select>
                        <div class="form-text small">The ticket will be logged on behalf of this user.</div>
                    </div>
                </div>
            </div>

            <!-- Reporting Identity Card -->
            <div class="card shadow-sm border-0">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center gap-2 small text-muted">
                        <i class="fa-solid fa-shield-check text-success fs-5"></i>
                        <div>
                            Logged in as <strong class="text-dark">@CurrentUser.GetFullName()</strong> (Domain: <code>@CurrentUser.GetDomainUser()</code>, Role: <strong>@CurrentUser.GetRole()</strong>).
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Ticket Category, Priority & Manual Notes Box -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="fa-solid fa-pen-to-square text-primary me-2"></i> Ticket Details & User Notes
                    </h6>
                </div>
                <div class="card-body p-4">
                    <!-- Issue Category & Priority -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Category" class="form-label fw-semibold small text-uppercase text-muted">
                                Issue Category
                            </label>
                            <select asp-for="Category" class="form-select">
                                <option value="Hardware" selected>Hardware Fault</option>
                                <option value="Software">Software / OS Issue</option>
                                <option value="Network">Network & WiFi</option>
                                <option value="Peripheral">Printer / Monitor / Scanner</option>
                                <option value="Maintenance">Preventive Maintenance</option>
                                <option value="Access">Login / Domain Access</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Priority" class="form-label fw-semibold small text-uppercase text-muted">
                                Priority Level
                            </label>
                            <select asp-for="Priority" class="form-select">
                                <option value="1">Low - Routine</option>
                                <option value="2" selected>Medium - Normal Work Impact</option>
                                <option value="3">High - Urgent Department Need</option>
                                <option value="4">Urgent - Clinical Emergency</option>
                            </select>
                        </div>
                    </div>

                    <!-- Quick Issue Templates / Chips -->
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-uppercase text-muted d-block">
                            <i class="fa-solid fa-wand-magic-sparkles text-warning me-1"></i> Quick Issue Templates (Click to insert):
                        </label>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary template-btn" data-text="Workstation is experiencing severe slowdown and applications freeze intermittently.">
                                ⏱️ Slow / Freezing
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary template-btn" data-text="Monitor screen flickers and loses display signal unexpectedly.">
                                🖥️ Display Flicker
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary template-btn" data-text="Cannot connect to internal hospital network or access local shared drives.">
                                🌐 Network Lost
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary template-btn" data-text="Network printer is offline and print jobs are stuck in queue.">
                                🖨️ Printer Error
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary template-btn" data-text="Operating system displayed a blue screen error and restarted automatically.">
                                ⚠️ Crash / BSOD
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary template-btn" data-text="Workstation won't turn on / power supply intermittent.">
                                🔌 Power Issue
                            </button>
                        </div>
                    </div>

                    <!-- Notes Box: To be edited by user manually -->
                    <div class="mb-4">
                        <label asp-for="UserNotes" class="form-label fw-bold text-dark d-flex justify-content-between align-items-center">
                            <span><i class="fa-solid fa-message text-primary me-1"></i> User Notes / Problem Description</span>
                            <span class="badge bg-light text-muted border fw-normal">Editable Manually</span>
                        </label>
                        <textarea asp-for="UserNotes" id="userNotesBox" class="form-control" rows="6" 
                                  placeholder="Type details regarding the issue you are experiencing on this workstation (e.g. error message text, steps to reproduce, urgency)..."></textarea>
                        <div class="form-text small">
                            These notes will be delivered directly to the assigned technical team alongside automated hardware specs.
                        </div>
                    </div>

                    <!-- Submit & Actions -->
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg fw-bold shadow-sm py-3 d-flex align-items-center justify-content-center gap-2">
                            <i class="fa-solid fa-bolt fs-5 text-warning"></i>
                            <span>Generate & Open Automated Ticket</span>
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-light border py-2">
                            Cancel
                        </a>
                    </div>
                </div>
            </div>

            <!-- Automated Preview Card -->
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body p-3">
                    <h6 class="fw-bold small text-muted text-uppercase mb-2">
                        <i class="fa-solid fa-eye me-1"></i> What happens when you submit?
                    </h6>
                    <ul class="small text-muted ps-3 mb-0">
                        <li>A new support ticket is opened immediately in status <strong>Opened</strong>.</li>
                        <li>Automated telemetry (PC Name, Room No, Hardware Serial, Custodian, IP) is attached as message #1.</li>
                        <li>Your manual notes are attached as message #2.</li>
                        <li>Technicians in the IT department will see the ticket in their active dispatch queue.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const assetSelect = document.getElementById("assetSelect");
        const roomSelect = document.getElementById("roomSelect");
        const userSelect = document.getElementById("userSelect");
        const valBrand = document.getElementById("valBrand");
        const valModel = document.getElementById("valModel");
        const valSerial = document.getElementById("valSerial");
        const notesBox = document.getElementById("userNotesBox");

        // Sync dropdown when selecting an asset
        if (assetSelect) {
            assetSelect.addEventListener("change", function () {
                const opt = assetSelect.options[assetSelect.selectedIndex];
                if (opt && opt.value) {
                    valBrand.textContent = opt.dataset.brand || "N/A";
                    valSerial.textContent = opt.dataset.serial || "N/A";
                    
                    if (opt.dataset.room && roomSelect) {
                        roomSelect.value = opt.dataset.room;
                    }
                    if (opt.dataset.user && userSelect) {
                        userSelect.value = opt.dataset.user;
                    }
                } else {
                    valBrand.textContent = "N/A";
                    valModel.textContent = "N/A";
                    valSerial.textContent = "N/A";
                }
            });
        }

        // Quick Issue Template Buttons
        const templateBtns = document.querySelectorAll(".template-btn");
        templateBtns.forEach(btn => {
            btn.addEventListener("click", function () {
                const text = this.getAttribute("data-text");
                if (notesBox) {
                    if (notesBox.value.trim().length > 0) {
                        notesBox.value += "\n" + text;
                    } else {
                        notesBox.value = text;
                    }
                    notesBox.focus();
                }
            });
        });
    });
</script>
}
