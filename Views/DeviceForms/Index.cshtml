@model IEnumerable<StockPortal.Models.DeviceForm>
@inject StockPortal.Services.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "Universal Device Forms & Specifications";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0"><i class="fa-solid fa-shapes text-primary me-2"></i> Device Specification Forms & Templates</h4>
        <small class="text-muted">Universal dynamic forms used to standardize equipment technical specifications in Hospital Assets</small>
    </div>
    <a href="@Url.Action("Create")" class="btn btn-primary">
        <i class="fa-solid fa-plus me-1"></i> Add New Device Form
    </a>
</div>

@if (CurrentUser.IsMaintenance())
{
    <div class="alert alert-info border-0 shadow-sm d-flex align-items-center gap-2 mb-4">
        <i class="fa-solid fa-screwdriver-wrench fs-5"></i>
        <div>
            <strong>@CurrentUser.GetMaintenanceTeam() Maintenance Scope:</strong> You can create and configure device forms for your department's equipment. These forms will be presented when registering new assets.
        </div>
    </div>
}

<div class="row g-4">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="card shadow-sm border-0 text-center py-5">
                <div class="card-body">
                    <i class="fa-solid fa-folder-open fa-3x text-muted mb-3"></i>
                    <h5 class="fw-bold">No Device Forms Configured</h5>
                    <p class="text-muted">Create your first universal device template to start standardizing equipment specifications.</p>
                    <a href="@Url.Action("Create")" class="btn btn-primary">
                        <i class="fa-solid fa-plus me-1"></i> Create Device Form
                    </a>
                </div>
            </div>
        </div>
    }
    @foreach (var form in Model)
    {
        var fields = form.Fields;
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="fa-solid fa-microchip text-primary me-1"></i> @form.Name
                    </h6>
                    <span class="badge @(form.Department == "BIOMEDICAL" ? "bg-info text-dark" : form.Department == "GENERAL" ? "bg-warning text-dark" : "bg-primary")">
                        @form.Department
                    </span>
                </div>
                <div class="card-body">
                    <div class="small text-muted mb-2 fw-semibold">Dynamic Specifications Schema (@fields.Count fields):</div>
                    <ul class="list-group list-group-flush small mb-3">
                        @foreach (var f in fields.Take(5))
                        {
                            <li class="list-group-item px-0 py-1 d-flex justify-content-between text-truncate">
                                <span class="fw-medium text-dark">&bull; @f.Label</span>
                                <span class="badge bg-light text-muted border">@f.Type</span>
                            </li>
                        }
                        @if (fields.Count > 5)
                        {
                            <li class="list-group-item px-0 py-1 text-muted text-center fst-italic">
                                + @(fields.Count - 5) more fields...
                            </li>
                        }
                    </ul>
                </div>
                <div class="card-footer bg-light border-0 d-flex justify-content-between align-items-center py-2">
                    <span class="small text-muted">ID: #@form.Id</span>
                    <div class="d-flex gap-1">
                        <a href="@Url.Action("Edit", new { id = form.Id })" class="btn btn-sm btn-outline-primary">
                            <i class="fa-solid fa-pen-to-square me-1"></i> Edit
                        </a>
                        <form method="post" asp-action="Delete" asp-route-id="@form.Id" onsubmit="return confirm('Are you sure you want to delete the @form.Name form?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
