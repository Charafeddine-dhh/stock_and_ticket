@model IEnumerable<StockPortal.Models.Notification>
@inject StockPortal.Services.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = "System & Department Notifications";
    string currentFilter = ViewBag.CurrentFilter as string ?? "all";
    int unreadCount = ViewBag.UnreadCount as int? ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">
            <i class="fa-solid fa-bell text-primary me-2"></i> Department & Ticket Updates
            @if (unreadCount > 0)
            {
                <span class="badge bg-danger fs-6 align-middle ms-2">@unreadCount Unread</span>
            }
        </h4>
        <small class="text-muted">Live activity stream for your department tickets, discussions, and system updates</small>
    </div>
    @if (unreadCount > 0)
    {
        <form asp-action="MarkAllAsRead" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-primary btn-sm">
                <i class="fa-solid fa-check-double me-1"></i> Mark All as Read
            </button>
        </form>
    }
</div>

<!-- Filter Tabs -->
<div class="card shadow-sm border-0 mb-4">
    <div class="card-body p-3">
        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", new { filter = "all" })" class="btn btn-sm @(currentFilter == "all" ? "btn-primary" : "btn-light border")">
                <i class="fa-solid fa-inbox me-1"></i> All Notifications
            </a>
            <a href="@Url.Action("Index", new { filter = "unread" })" class="btn btn-sm @(currentFilter == "unread" ? "btn-primary" : "btn-light border")">
                <i class="fa-solid fa-envelope me-1"></i> Unread Only (@unreadCount)
            </a>
        </div>
    </div>
</div>

<!-- Notifications List -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="fa-regular fa-bell-slash fa-3x mb-3 text-secondary"></i>
                <div class="fw-semibold">No notifications found</div>
                <small class="text-muted">You are all caught up on department and ticket activity.</small>
            </div>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var item in Model)
                {
                    <div class="list-group-item p-3 @(!item.IsRead ? "bg-light bg-opacity-50" : "") transition-all">
                        <div class="d-flex align-items-start gap-3">
                            <!-- Icon -->
                            <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 mt-1" 
                                 style="width: 40px; height: 40px; background: @(item.Type == "TicketOpened" ? "#eff6ff" : item.Type == "MessageAdded" ? "#f0fdf4" : "#fef3c7"); color: @(item.Type == "TicketOpened" ? "#2563eb" : item.Type == "MessageAdded" ? "#16a34a" : "#d97706");">
                                @if (item.Type == "TicketOpened")
                                {
                                    <i class="fa-solid fa-ticket"></i>
                                }
                                else if (item.Type == "MessageAdded")
                                {
                                    <i class="fa-solid fa-comment-dots"></i>
                                }
                                else
                                {
                                    <i class="fa-solid fa-arrows-rotate"></i>
                                }
                            </div>

                            <!-- Content -->
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div class="fw-bold text-dark d-flex align-items-center gap-2">
                                        @item.Title
                                        @if (!item.IsRead)
                                        {
                                            <span class="badge bg-primary" style="font-size: 0.65rem;">New</span>
                                        }
                                    </div>
                                    <small class="text-muted">@item.CreatedAt.ToString("MMM dd, yyyy HH:mm")</small>
                                </div>
                                <div class="text-secondary small mb-2" style="white-space: pre-wrap;">@item.Message</div>
                                <div class="d-flex gap-2 align-items-center">
                                    @if (!string.IsNullOrWhiteSpace(item.LinkUrl))
                                    {
                                        <a href="@item.LinkUrl" class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size: 0.8rem;">
                                            <i class="fa-solid fa-arrow-up-right-from-square me-1"></i> View Ticket
                                        </a>
                                    }
                                    @if (!item.IsRead)
                                    {
                                        <form asp-action="MarkAsRead" method="post" class="d-inline m-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                            <button type="submit" class="btn btn-sm btn-link text-muted text-decoration-none py-0 px-1" style="font-size: 0.8rem;">
                                                <i class="fa-solid fa-check me-1"></i> Mark as read
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
