@model StockPortal.Models.Asset
@{
    ViewData["Title"] = $"Delete Asset: {Model.HospitalNo ?? ("#" + Model.Id)}";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="fa-solid fa-triangle-exclamation me-2"></i> Delete Asset Confirmation</h5>
            </div>
            <div class="card-body p-4">
                <p class="text-danger fw-semibold">
                    Warning: Deleting an asset removes it permanently from the inventory database.
                </p>
                <div class="bg-light p-3 rounded mb-3">
                    <div class="row g-2">
                        <div class="col-4 text-muted">Asset Tag:</div>
                        <div class="col-8 fw-bold">@(Model.HospitalNo ?? "N/A")</div>

                        <div class="col-4 text-muted">Serial Number:</div>
                        <div class="col-8 font-monospace">@(Model.SerialNo ?? "N/A")</div>

                        <div class="col-4 text-muted">Brand & Type:</div>
                        <div class="col-8">@(Model.Brand) - @(Model.Type)</div>

                        <div class="col-4 text-muted">Location:</div>
                        <div class="col-8">@(Model.Room?.DisplayName ?? "Unassigned")</div>

                        <div class="col-4 text-muted">Custodian:</div>
                        <div class="col-8">@(Model.User?.FullName ?? "None")</div>

                        <div class="col-4 text-muted">Status:</div>
                        <div class="col-8"><span class="badge bg-secondary">@(Model.Status)</span></div>
                    </div>
                </div>

                @if (Model.Tickets.Any(t => t.StatusId != 5 && t.StatusId != 4))
                {
                    <div class="alert alert-warning d-flex align-items-center gap-2">
                        <i class="fa-solid fa-circle-exclamation fs-4"></i>
                        <div>
                            This asset has <strong>@Model.Tickets.Count(t => t.StatusId != 5 && t.StatusId != 4)</strong> active ticket(s). You must resolve or close them first, or retire the asset instead.
                        </div>
                    </div>
                }
                else
                {
                    <p class="text-muted small">
                        Tip: If this hardware is merely decommissioned or broken beyond repair, consider using the <strong>Retire</strong> feature instead to preserve maintenance and custody audit history.
                    </p>
                }

                <div class="d-flex justify-content-between align-items-center mt-4">
                    <a href="@Url.Action("Details", new { id = Model.Id })" class="btn btn-secondary">
                        <i class="fa-solid fa-arrow-left me-1"></i> Cancel & Return
                    </a>
                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-danger" @(Model.Tickets.Any(t => t.StatusId != 5 && t.StatusId != 4) ? "disabled" : "")>
                            <i class="fa-solid fa-trash me-1"></i> Permanently Delete
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
