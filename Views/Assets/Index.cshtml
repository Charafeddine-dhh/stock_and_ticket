@model IEnumerable<StockPortal.Models.Asset>
@inject StockPortal.Services.ICurrentUserService CurrentUser
@{
    ViewData["Title"] = CurrentUser.IsEndUser() ? "My Assigned Equipment" : "Stock & IT Asset Inventory";
    var rooms = ViewBag.Rooms as List<StockPortal.Models.Room> ?? new();
    var types = ViewBag.Types as List<string> ?? new();
    var selectedWarranty = ViewBag.SelectedWarranty as string;
    bool canManage = CurrentUser.CanManageAssets();
}

<!-- Filter & Search Toolbar -->
<div class="card shadow-sm mb-4 border-0">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center" id="assetsFilterForm">
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="fa-solid fa-magnifying-glass"></i></span>
                    <input type="text" name="search" id="assetSearchInput" value="@ViewBag.Search" class="form-control border-start-0 ps-0" placeholder="Type to search (Tag, Serial, Brand, User)..." autocomplete="off">
                </div>
            </div>
            <div class="col-md-2">
                <select name="status" class="form-select" onchange="this.form.submit()">
                    <option value="">All Statuses</option>
                    <option value="In Service" selected="@(ViewBag.SelectedStatus == "In Service")">In Service</option>
                    <option value="In Stock" selected="@(ViewBag.SelectedStatus == "In Stock")">In Stock (Spare)</option>
                    <option value="Under Maintenance" selected="@(ViewBag.SelectedStatus == "Under Maintenance")">Under Maintenance</option>
                    <option value="Retired" selected="@(ViewBag.SelectedStatus == "Retired")">Retired / Scrapped</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="type" class="form-select" onchange="this.form.submit()">
                    <option value="">All Equipment Types</option>
                    @foreach (var t in types)
                    {
                        <option value="@t" selected="@(ViewBag.SelectedType == t)">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="roomId" class="form-select" onchange="this.form.submit()">
                    <option value="">All Locations</option>
                    @foreach (var r in rooms)
                    {
                        <option value="@r.Id" selected="@(ViewBag.SelectedRoomId == r.Id)">@r.DisplayName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select name="warranty" class="form-select" onchange="this.form.submit()">
                    <option value="">All Warranties</option>
                    <option value="active" selected="@(selectedWarranty == "active")">Warranty Active</option>
                    <option value="expiring30" selected="@(selectedWarranty == "expiring30")">Expiring in 30 Days</option>
                    <option value="expired" selected="@(selectedWarranty == "expired")">Warranty Expired</option>
                </select>
            </div>
            <div class="col-md-1">
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary w-100" title="Reset Filters"><i class="fa-solid fa-rotate-left me-1"></i> Reset</a>
            </div>
        </form>
    </div>
</div>

<!-- Assets Data Table -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <div>
            <h6 class="mb-0 fw-bold">@(CurrentUser.IsEndUser() ? "My Custody Equipment" : "Inventory Assets List")</h6>
            <small class="text-muted">
                @(CurrentUser.IsEndUser() ? $"Showing {Model.Count()} equipment items currently in your custody" : $"Showing {Model.Count()} registered items • Total Value: {Model.Sum(a => a.Price ?? 0):C0}")
            </small>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("ExportCsv", new { search = ViewBag.Search, status = ViewBag.SelectedStatus, type = ViewBag.SelectedType, roomId = ViewBag.SelectedRoomId })" class="btn btn-outline-success btn-sm">
                <i class="fa-solid fa-file-csv me-1"></i> Export CSV
            </a>
            @if (canManage)
            {
                <a href="@Url.Action("Create")" class="btn btn-primary btn-sm">
                    <i class="fa-solid fa-plus me-1"></i> Register New Asset
                </a>
            }
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Asset Tag / Hospital No</th>
                        <th>Team</th>
                        <th>Brand & Model</th>
                        <th>Type</th>
                        <th>Location</th>
                        <th>Custodian</th>
                        <th>Status</th>
                        <th>Preventive Check</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-5">
                                <i class="fa-solid fa-box-open fa-2x mb-2 text-secondary"></i>
                                <div>No assets match your search criteria.</div>
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <a href="@Url.Action("Details", new { id = item.Id })" class="fw-bold text-decoration-none">
                                    <i class="fa-solid fa-barcode text-muted me-1"></i> @(string.IsNullOrWhiteSpace(item.HospitalNo) ? $"ASSET-#{item.Id}" : item.HospitalNo)
                                </a>
                                <div class="small text-muted font-monospace" style="font-size: 0.75rem;">SN: @(item.SerialNo ?? "N/A")</div>
                            </td>
                            <td>
                                <span class="badge @(item.MaintenanceTeam == "BIOMEDICAL" ? "bg-info text-dark" : item.MaintenanceTeam == "GENERAL" ? "bg-warning text-dark" : "bg-primary")">
                                    @item.MaintenanceTeam
                                </span>
                            </td>
                            <td>
                                <div class="fw-semibold">@(item.Brand ?? "Unbranded")</div>
                                <div class="small text-muted">Model: @(item.ModelNo.HasValue ? item.ModelNo.ToString() : "Standard")</div>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@item.Type</span>
                            </td>
                            <td>
                                @if (item.Room != null)
                                {
                                    <span><i class="fa-solid fa-location-dot text-danger me-1"></i> @item.Room.DisplayName</span>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Unassigned</span>
                                }
                            </td>
                            <td>
                                @if (item.User != null)
                                {
                                    <div><i class="fa-solid fa-user text-primary me-1"></i> @item.User.FullName</div>
                                    <div class="small text-muted" style="font-size: 0.72rem;">@(item.CustodyType?.Type ?? "Custody")</div>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Central Stock</span>
                                }
                            </td>
                            <td>
                                @switch (item.Status)
                                {
                                    case "In Service":
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success">
                                            <i class="fa-solid fa-circle-check me-1"></i> In Service
                                        </span>
                                        break;
                                    case "Under Maintenance":
                                        <span class="badge bg-warning bg-opacity-10 text-warning border border-warning">
                                            <i class="fa-solid fa-wrench me-1"></i> Maintenance
                                        </span>
                                        break;
                                    case "In Stock":
                                        <span class="badge bg-info bg-opacity-10 text-info border border-info">
                                            <i class="fa-solid fa-box me-1"></i> Spare Stock
                                        </span>
                                        break;
                                    case "Retired":
                                        <span class="badge bg-secondary bg-opacity-10 text-secondary border">
                                            <i class="fa-solid fa-ban me-1"></i> Retired
                                        </span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">@(item.Status ?? "Unknown")</span>
                                        break;
                                }
                            </td>
                            <td>
                                @if (item.NeedsPeriodic == true)
                                {
                                    if (item.NextPeriodic.HasValue && item.NextPeriodic.Value < DateTime.Now.Date)
                                    {
                                        <span class="badge bg-danger" title="Overdue by @((DateTime.Now.Date - item.NextPeriodic.Value).Days) days">
                                            Overdue (@item.NextPeriodic?.ToString("MMM dd"))
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-success border border-success">
                                            Due: @item.NextPeriodic?.ToString("MMM dd, yyyy")
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="small text-muted">Not Required</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a href="@Url.Action("Details", new { id = item.Id })" class="btn btn-outline-primary" title="View Full Details">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                    <a href="@Url.Action("PrintTag", new { id = item.Id })" class="btn btn-outline-dark" title="Print Barcode Tag" target="_blank">
                                        <i class="fa-solid fa-print"></i>
                                    </a>
                                    @if (CurrentUser.CanManageAsset(item))
                                    {
                                        <a href="@Url.Action("Edit", new { id = item.Id })" class="btn btn-outline-secondary" title="Edit Asset">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>
                                    }
                                    <a href="@Url.Action("Create", "Tickets", new { assetId = item.Id })" class="btn btn-outline-warning" title="Open Ticket for Asset">
                                        <i class="fa-solid fa-ticket"></i>
                                    </a>
                                    @if (CurrentUser.IsAdmin())
                                    {
                                        <form method="post" asp-action="Delete" asp-route-id="@item.Id" class="d-inline" onsubmit="return confirm('Are you sure you want to delete asset @item.HospitalNo?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Delete Asset">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const searchInput = document.getElementById("assetSearchInput");
        if (searchInput) {
            let debounceTimer;
            searchInput.addEventListener("input", function () {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(() => {
                    this.form.submit();
                }, 400);
            });
            // Focus and put cursor at end of input if search has value
            if (searchInput.value) {
                const len = searchInput.value.length;
                searchInput.focus();
                searchInput.setSelectionRange(len, len);
            }
        }
    });
</script>
}
