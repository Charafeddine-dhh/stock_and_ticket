@model StockPortal.Models.Asset
@{
    Layout = null;
    var tag = string.IsNullOrWhiteSpace(Model.HospitalNo) ? $"ASSET-{Model.Id:D5}" : Model.HospitalNo;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Print Asset Tag - @tag</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <style>
        @@media print {
            .no-print { display: none !important; }
            body { background: white !important; padding: 0 !important; margin: 0 !important; }
            .tag-card { border: 2px solid #000 !important; box-shadow: none !important; page-break-inside: avoid; }
        }
        body {
            background-color: #f1f5f9;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            padding: 2rem;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .tag-card {
            width: 360px;
            background: #ffffff;
            border: 2px solid #0f172a;
            border-radius: 8px;
            padding: 16px;
            box-shadow: 0 4px 6px -1px rgba(0,0,0,0.1);
        }
        .barcode {
            letter-spacing: 5px;
            font-family: monospace;
            font-size: 20px;
            background: #f8fafc;
            border: 1px dashed #cbd5e1;
            padding: 8px;
            text-align: center;
            font-weight: 700;
        }
    </style>
</head>
<body>
    <div class="no-print mb-4 d-flex gap-2">
        <button onclick="window.print()" class="btn btn-primary btn-lg shadow-sm">
            <i class="fa-solid fa-print me-2"></i> Print Asset Tag Label
        </button>
        <button onclick="window.close()" class="btn btn-outline-secondary btn-lg">
            Close
        </button>
    </div>

    <div class="tag-card">
        <div class="d-flex align-items-center justify-content-between border-bottom pb-2 mb-2">
            <div>
                <div class="fw-bold text-uppercase" style="font-size: 11px; letter-spacing: 1px; color: #475569;">Hospital IT Property</div>
                <div class="fw-bold" style="font-size: 15px; color: #0f172a;">ASSET IDENTIFICATION TAG</div>
            </div>
            <i class="fa-solid fa-server fa-2x text-primary"></i>
        </div>

        <div class="text-center my-2">
            <div class="barcode">||| | |||| | ||| || |||</div>
            <div class="fw-bold font-monospace mt-1" style="font-size: 18px; letter-spacing: 2px;">@tag</div>
        </div>

        <div class="small mt-2 pt-2 border-top">
            <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">Type:</span>
                <span class="fw-semibold">@(Model.Type ?? "Hardware")</span>
            </div>
            <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">Make/Model:</span>
                <span class="fw-semibold">@(Model.Brand) @(Model.ModelNo.HasValue ? Model.ModelNo.ToString() : "")</span>
            </div>
            <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">Serial No:</span>
                <span class="font-monospace fw-semibold">@(Model.SerialNo ?? "N/A")</span>
            </div>
            <div class="d-flex justify-content-between mb-1">
                <span class="text-muted">Location:</span>
                <span class="fw-semibold">@(Model.Room?.DisplayName ?? "Unassigned")</span>
            </div>
            <div class="d-flex justify-content-between">
                <span class="text-muted">Custodian:</span>
                <span class="fw-semibold">@(Model.User?.FullName ?? "General IT")</span>
            </div>
        </div>

        <div class="mt-3 pt-2 border-top text-center" style="font-size: 9px; color: #64748b;">
            DO NOT REMOVE OR DEFACE &bull; PROPERTY OF HEALTHCARE FACILITY
        </div>
    </div>
</body>
</html>
