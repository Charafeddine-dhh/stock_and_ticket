@{
    ViewData["Title"] = "Master Directory & Administration";
    var users = ViewBag.Users as List<StockPortal.Models.User> ?? new();
    var rooms = ViewBag.Rooms as List<StockPortal.Models.Room> ?? new();
    var suppliers = ViewBag.Suppliers as List<StockPortal.Models.Supplier> ?? new();
    var departments = ViewBag.Departments as List<StockPortal.Models.Department> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0">Master Directory & Configuration</h4>
        <small class="text-muted">Manage hospital departments, staff users, physical room locations, and authorized vendors</small>
    </div>
</div>

<!-- Tabs for Directory Items -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white p-0">
        <ul class="nav nav-tabs card-header-tabs m-0 px-3 pt-2" id="dirTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active fw-semibold" id="users-tab" data-bs-toggle="tab" data-bs-target="#users" type="button" role="tab">
                    <i class="fa-solid fa-users me-1"></i> Staff & Users (@users.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link fw-semibold" id="rooms-tab" data-bs-toggle="tab" data-bs-target="#rooms" type="button" role="tab">
                    <i class="fa-solid fa-door-open me-1"></i> Rooms & Locations (@rooms.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link fw-semibold" id="suppliers-tab" data-bs-toggle="tab" data-bs-target="#suppliers" type="button" role="tab">
                    <i class="fa-solid fa-truck-field me-1"></i> Suppliers & Vendors (@suppliers.Count)
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link fw-semibold" id="depts-tab" data-bs-toggle="tab" data-bs-target="#depts" type="button" role="tab">
                    <i class="fa-solid fa-building me-1"></i> Departments (@departments.Count)
                </button>
            </li>
        </ul>
    </div>
    <div class="card-body p-4">
        <div class="tab-content" id="dirTabsContent">
            <!-- 1. Users Tab -->
            <div class="tab-pane fade show active" id="users" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h6 class="fw-bold mb-0">Hospital Staff & Authorized Users</h6>
                        <small class="text-muted">Users with <strong>Active</strong> status are automatically authenticated via their PC username. Inactive users are rejected.</small>
                    </div>
                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addUserModal">
                        <i class="fa-solid fa-plus me-1"></i> Add User
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Full Name</th>
                                <th>PC / Windows Username</th>
                                <th>Department</th>
                                <th>System Role</th>
                                <th>Maintenance Team</th>
                                <th>Auto-Login Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in users)
                            {
                                <tr>
                                    <td>@u.Id</td>
                                    <td class="fw-semibold">@u.FullName</td>
                                    <td><code class="text-primary fw-bold bg-light px-2 py-1 rounded">@(u.DomainUser ?? "-")</code></td>
                                    <td>@(u.Department?.Name ?? "Unassigned")</td>
                                    <td>
                                        @switch (u.Role?.ToUpperInvariant())
                                        {
                                            case "ADMIN":
                                                <span class="badge bg-danger"><i class="fa-solid fa-shield-halved me-1"></i> ADMIN</span>
                                                break;
                                            case "MAINTENANCE":
                                                <span class="badge bg-primary"><i class="fa-solid fa-wrench me-1"></i> MAINTENANCE</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary"><i class="fa-solid fa-user me-1"></i> END_USER</span>
                                                break;
                                        }
                                    </td>
                                    <td>
                                        @if (u.Role?.ToUpperInvariant() == "MAINTENANCE")
                                        {
                                            <span class="badge @(u.MaintenanceTeam == "BIOMEDICAL" ? "bg-info text-dark" : u.MaintenanceTeam == "GENERAL" ? "bg-warning text-dark" : "bg-dark")">
                                                @(u.MaintenanceTeam ?? "IT")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (u.IsActive == true)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success">
                                                <i class="fa-solid fa-circle-check me-1"></i> Active (Auto-Login)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger">
                                                <i class="fa-solid fa-ban me-1"></i> Inactive (Rejected)
                                            </span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-primary me-1" data-bs-toggle="modal" data-bs-target="#editRoleModal-@u.Id" title="Edit Role & Maintenance Team">
                                            <i class="fa-solid fa-user-gear"></i> Role
                                        </button>
                                        <form asp-action="ToggleUserStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@u.Id" />
                                            <button type="submit" class="btn btn-sm @(u.IsActive == true ? "btn-outline-danger" : "btn-outline-success")" title="Toggle active/inactive status">
                                                @(u.IsActive == true ? "Deactivate" : "Activate")
                                            </button>
                                        </form>

                                        <!-- Modal: Edit Role & Team -->
                                        <div class="modal fade text-start" id="editRoleModal-@u.Id" tabindex="-1">
                                            <div class="modal-dialog">
                                                <div class="modal-content">
                                                    <form asp-action="UpdateUserRole" method="post">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="id" value="@u.Id" />
                                                        <div class="modal-header">
                                                            <h5 class="modal-title fw-bold">Manage Role & Team: @u.FullName</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <div class="mb-3">
                                                                <label class="form-label fw-semibold">System RBAC Role</label>
                                                                <select name="role" id="role-select-@u.Id" class="form-select" onchange="toggleTeamSelect(@u.Id)">
                                                                    <option value="ADMIN" selected="@(u.Role?.ToUpperInvariant() == "ADMIN")">ADMIN (Full System Access)</option>
                                                                    <option value="MAINTENANCE" selected="@(u.Role?.ToUpperInvariant() == "MAINTENANCE")">MAINTENANCE (Assigned Maintenance Team)</option>
                                                                    <option value="END_USER" selected="@(u.Role?.ToUpperInvariant() == "END_USER" || string.IsNullOrWhiteSpace(u.Role))">END_USER (Standard Staff)</option>
                                                                </select>
                                                            </div>
                                                            <div class="mb-3" id="team-container-@u.Id" style="@(u.Role?.ToUpperInvariant() == "MAINTENANCE" ? "" : "display:none;")">
                                                                <label class="form-label fw-semibold">Assigned Maintenance Team</label>
                                                                <select name="maintenanceTeam" class="form-select">
                                                                    <option value="IT" selected="@(u.MaintenanceTeam == "IT" || string.IsNullOrWhiteSpace(u.MaintenanceTeam))">IT</option>
                                                                    <option value="BIOMEDICAL" selected="@(u.MaintenanceTeam == "BIOMEDICAL")">BIOMEDICAL</option>
                                                                    <option value="GENERAL" selected="@(u.MaintenanceTeam == "GENERAL")">GENERAL</option>
                                                                </select>
                                                                <div class="form-text small">Maintenance users can view and handle tickets directed to their team only.</div>
                                                            </div>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-primary">Save Role & Team</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 2. Rooms Tab -->
            <div class="tab-pane fade" id="rooms" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0">Physical Rooms & Storage Areas</h6>
                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addRoomModal">
                        <i class="fa-solid fa-plus me-1"></i> Add Room
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Room Number</th>
                                <th>Floor</th>
                                <th>Display Reference</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in rooms)
                            {
                                <tr>
                                    <td>@r.Id</td>
                                    <td class="fw-semibold"><i class="fa-solid fa-door-closed text-muted me-2"></i> Room @r.RoomNo</td>
                                    <td>Floor @r.Floor</td>
                                    <td><span class="badge bg-light text-dark border">@r.DisplayName</span></td>
                                    <td class="text-end">
                                        <form asp-action="DeleteRoom" method="post" class="d-inline" onsubmit="return confirm('Delete Room @r.RoomNo?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fa-solid fa-trash me-1"></i> Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 3. Suppliers Tab -->
            <div class="tab-pane fade" id="suppliers" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0">Authorized Hardware Suppliers & Maintenance Contractors</h6>
                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addSupplierModal">
                        <i class="fa-solid fa-plus me-1"></i> Add Supplier
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Vendor / Company Name</th>
                                <th>Service Scope</th>
                                <th>Status</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in suppliers)
                            {
                                <tr>
                                    <td>@s.Id</td>
                                    <td class="fw-semibold"><i class="fa-solid fa-truck text-muted me-2"></i> @s.Name</td>
                                    <td><span class="badge bg-light text-dark border">@s.TypeName</span></td>
                                    <td>
                                        <span class="badge @(s.IsActive == true ? "bg-success" : "bg-secondary")">
                                            @(s.IsActive == true ? "Active Vendor" : "Inactive")
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <form asp-action="ToggleSupplierStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@s.Id" />
                                            <button type="submit" class="btn btn-sm @(s.IsActive == true ? "btn-outline-secondary" : "btn-outline-success")">
                                                @(s.IsActive == true ? "Deactivate" : "Activate")
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 4. Departments Tab -->
            <div class="tab-pane fade" id="depts" role="tabpanel">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold mb-0">Hospital Departments</h6>
                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#addDeptModal">
                        <i class="fa-solid fa-plus me-1"></i> Add Department
                    </button>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Department Name</th>
                                <th>Department Head</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var d in departments)
                            {
                                <tr>
                                    <td>@d.Id</td>
                                    <td class="fw-semibold">@d.Name</td>
                                    <td>@(d.HeadUser?.FullName ?? "None assigned")</td>
                                    <td class="text-end">
                                        <form asp-action="DeleteDepartment" method="post" class="d-inline" onsubmit="return confirm('Remove department @d.Name?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@d.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="fa-solid fa-trash me-1"></i> Remove
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Add User -->
<div class="modal fade" id="addUserModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateUser" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add Staff / User</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Full Name <span class="text-danger">*</span></label>
                        <input type="text" name="FullName" class="form-control" placeholder="e.g. John Doe" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">PC / Windows Username (for Auto-Login) <span class="text-danger">*</span></label>
                        <input type="text" name="DomainUser" class="form-control font-monospace" placeholder="e.g. @Environment.UserName" required />
                        <div class="form-text small text-muted">
                            <i class="fa-solid fa-circle-info me-1"></i> Must match the user's computer account name. Auto-login grants instant access when they open the site from their PC.
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">System RBAC Role <span class="text-danger">*</span></label>
                        <select name="Role" id="newRoleSelect" class="form-select" onchange="toggleNewUserTeam()">
                            <option value="END_USER" selected>END_USER (Standard Staff)</option>
                            <option value="MAINTENANCE">MAINTENANCE (Assigned Maintenance Team)</option>
                            <option value="ADMIN">ADMIN (Full System Access)</option>
                        </select>
                    </div>
                    <div class="mb-3" id="newUserTeamContainer" style="display: none;">
                        <label class="form-label fw-semibold">Assigned Maintenance Team</label>
                        <select name="MaintenanceTeam" class="form-select">
                            <option value="IT" selected>IT</option>
                            <option value="BIOMEDICAL">BIOMEDICAL</option>
                            <option value="GENERAL">GENERAL</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Department</label>
                        <select name="DepartmentId" class="form-select">
                            <option value="">-- None --</option>
                            @foreach (var d in departments)
                            {
                                <option value="@d.Id">@d.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save User</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Add Room -->
<div class="modal fade" id="addRoomModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateRoom" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add Room Location</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Room Number</label>
                        <input type="number" name="RoomNo" class="form-control" placeholder="e.g. 104" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Floor</label>
                        <input type="number" name="Floor" class="form-control" placeholder="e.g. 1" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Room</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Add Supplier -->
<div class="modal fade" id="addSupplierModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateSupplier" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add Vendor / Supplier</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Company / Vendor Name</label>
                        <input type="text" name="Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Service Scope</label>
                        <select name="Type" class="form-select">
                            <option value="1">Equipment & Items</option>
                            <option value="2">Maintenance Provider</option>
                            <option value="3" selected>Full Service (Items & Maintenance)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Supplier</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Add Department -->
<div class="modal fade" id="addDeptModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="CreateDepartment" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">Add Department</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Department Name</label>
                        <input type="text" name="Name" class="form-control" placeholder="e.g. Neurology & Stroke Unit" required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Department</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function toggleTeamSelect(userId) {
        var roleSelect = document.getElementById('role-select-' + userId);
        var container = document.getElementById('team-container-' + userId);
        if (roleSelect && container) {
            container.style.display = (roleSelect.value === 'MAINTENANCE') ? 'block' : 'none';
        }
    }

    function toggleNewUserTeam() {
        var roleSelect = document.getElementById('newRoleSelect');
        var container = document.getElementById('newUserTeamContainer');
        if (roleSelect && container) {
            container.style.display = (roleSelect.value === 'MAINTENANCE') ? 'block' : 'none';
        }
    }
</script>
}
